generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum TutorType {
  WRITING_TASK1
  WRITING_TASK2
  LISTENING
  SPEAKING
  READING_ACADEMIC
  READING_GENERAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageContentType {
  TEXT
  AUDIO
  IMAGE
  ESSAY_EVALUATION
  LISTENING_EXERCISE
  READING_PASSAGE
  SPEAKING_FEEDBACK
}

enum PlacementSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum RoadmapPlanStatus {
  ACTIVE
  ARCHIVED
}

enum RoadmapTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum IeltsTestType {
  ACADEMIC
}

enum DiagnosticAttemptStatus {
  GENERATED
  SUBMITTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  avatar        String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  vocabs        Vocab[]
  grammarEntries GrammarEntry[]
  grammarStudyProgresses GrammarStudyProgress[]
  playlists     Playlist[]
  musicTracks   MusicTrack[]
  chatSessions  ChatSession[]
  diagnosticResults DiagnosticResult[]
  diagnosticAttempts DiagnosticAttempt[]
  listeningAudioAssets ListeningAudioAsset[]
  roadmapPlans  RoadmapPlan[]
  deepPlans     DeepPlan[]
  dailyPlans    DailyPlan[]
  notes         Note[]
  spacedReviews SpacedReview[]
}

model ChatSession {
  id          String     @id @default(cuid())
  title       String?
  tutorType   TutorType
  userId      String
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, tutorType])
  @@index([userId, updatedAt])
}

model ChatMessage {
  id            String             @id @default(cuid())
  sessionId     String
  role          MessageRole
  content       String             @db.Text
  contentType   MessageContentType @default(TEXT)
  metadata      Json?
  audioUrl      String?
  imageUrl      String?
  createdAt     DateTime           @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

enum MusicPlatform {
  YOUTUBE
  SPOTIFY
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vocab {
  id            String   @id @default(cuid())
  word          String
  image         String?
  grammar       String?
  pronunciation String?
  category      String?
  meaning       String?
  example       String?
  usageContext  String?
  note          String?
  synonym       String?
  antonym       String?
  singularForm  String?
  pluralForm    String?
  v2Form        String?
  v3Form        String?
  notes         String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GrammarEntry {
  id               String   @id @default(cuid())
  title            String
  slug             String
  grammarType      String?
  level            String?
  explanation      String   @db.Text
  usageGuide       String?  @db.Text
  structurePattern String?  @db.Text
  exampleSentence  String?  @db.Text
  storyExample     String?  @db.Text
  practiceHint     String?  @db.Text
  tags             String[] @default([])
  isSeed           Boolean  @default(false)
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgresses GrammarStudyProgress[]

  @@index([userId, grammarType])
  @@unique([userId, slug])
}

model GrammarStudyProgress {
  id             String   @id @default(cuid())
  userId         String
  grammarEntryId String
  isCompleted    Boolean  @default(false)
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammarEntry GrammarEntry @relation(fields: [grammarEntryId], references: [id], onDelete: Cascade)

  @@unique([userId, grammarEntryId])
  @@index([userId, isCompleted])
  @@index([grammarEntryId])
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([createdById])
  @@index([createdAt])
}

model MusicTrack {
  id         String          @id @default(cuid())
  title      String
  url        String
  platform   MusicPlatform
  platformId String
  thumbnail  String?
  artist     String?
  addedById  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  addedBy   User            @relation(fields: [addedById], references: [id], onDelete: Cascade)
  playlists PlaylistTrack[]

  @@index([addedById])
  @@index([platform, platformId])
  @@index([createdAt])
}

model PlaylistTrack {
  id         String    @id @default(cuid())
  playlistId String
  trackId    String
  order      Int
  addedAt    DateTime  @default(now())

  playlist Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, order])
  @@index([trackId])
}

model DiagnosticResult {
  id           String           @id @default(cuid())
  userId       String
  takenAt      DateTime         @default(now())
  expiresAt    DateTime
  overallBand  Float
  listeningBand Float
  readingBand  Float
  writingBand  Float
  speakingBand Float
  weakSkills   PlacementSkill[] @default([])
  strongSkills PlacementSkill[] @default([])
  rawAnswers   Json?
  createdAt    DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapPlans RoadmapPlan[]

  @@index([userId, takenAt])
}

model DiagnosticAttempt {
  id               String                  @id @default(cuid())
  userId           String
  ieltsType        IeltsTestType           @default(ACADEMIC)
  status           DiagnosticAttemptStatus @default(GENERATED)
  survey           Json
  generatedTest    Json
  submittedAnswers Json?
  skillScores      Json?
  aiReview         Json?
  diagnosticResultId String?
  provider         String?
  modelUsed        String?
  createdAt        DateTime                @default(now())
  submittedAt      DateTime?
  updatedAt        DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([diagnosticResultId])
}

model ListeningAudioAsset {
  id          String   @id @default(cuid())
  userId      String
  attemptId   String?
  url         String
  filename    String?
  mimeType    String?
  size        Int?
  durationSec Int?
  sourceNote  String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([attemptId])
}

model RoadmapPlan {
  id                       String            @id @default(cuid())
  userId                   String
  diagnosticResultId       String
  status                   RoadmapPlanStatus @default(ACTIVE)
  targetBandScore          Float
  availableTimePerWeek     Int
  studyMaterialsPreference String?
  skillGaps                String?
  estimatedTimeline        String
  weeklyStudyPlanText      String            @db.Text
  suggestedResourcesText   String            @db.Text
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosticResult DiagnosticResult @relation(fields: [diagnosticResultId], references: [id], onDelete: Restrict)
  weeks            RoadmapWeek[]
  replanEvents     RoadmapReplanEvent[]

  @@index([userId, status])
  @@index([diagnosticResultId])
}

model RoadmapWeek {
  id              String           @id @default(cuid())
  roadmapPlanId   String
  weekIndex       Int
  phase           String?
  focusSkills     PlacementSkill[] @default([])
  targetHours     Int
  successCriteria String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roadmapPlan RoadmapPlan @relation(fields: [roadmapPlanId], references: [id], onDelete: Cascade)
  tasks      RoadmapTask[]

  @@unique([roadmapPlanId, weekIndex])
  @@index([roadmapPlanId, weekIndex])
}

model RoadmapTask {
  id               String           @id @default(cuid())
  roadmapWeekId    String
  title            String
  skill            PlacementSkill
  taskType         String
  linkedPath       String?
  estimatedMinutes Int
  mandatory        Boolean          @default(true)
  dueDate          DateTime?
  status           RoadmapTaskStatus @default(TODO)
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  roadmapWeek RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)

  @@index([roadmapWeekId, status])
}

model RoadmapReplanEvent {
  id               String     @id @default(cuid())
  roadmapPlanId    String
  reason           String
  completionRate   Float?
  adjustmentPercent Int?
  summary          String?
  createdAt        DateTime   @default(now())

  roadmapPlan RoadmapPlan @relation(fields: [roadmapPlanId], references: [id], onDelete: Cascade)

  @@index([roadmapPlanId, createdAt])
}

// ===== DEEP WORKSPACE CONTROL MODELS =====

enum DeepPlanStatus {
  DRAFT
  PENDING_EDIT
  APPROVED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum PlanTaskStatus2 {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PlanTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model DeepPlan {
  id            String         @id @default(cuid())
  userId        String
  title         String
  description   String?        @db.Text
  topic         String
  subTopics     String[]       @default([])
  status        DeepPlanStatus @default(DRAFT)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlans    DailyPlan[]
  editRequests  PlanEditRequest[]

  @@index([userId, status])
  @@index([userId, topic])
}

model DailyPlan {
  id            String         @id @default(cuid())
  deepPlanId    String
  userId        String
  date          DateTime       @db.Date
  timeSlotStart String
  timeSlotEnd   String
  status        DeepPlanStatus @default(DRAFT)
  aiSuggestion  Json?
  completionRate Float         @default(0)
  selfRating    Int?
  reflection    String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  deepPlan      DeepPlan       @relation(fields: [deepPlanId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         PlanTask2[]
  notes         Note[]

  @@unique([deepPlanId, date])
  @@index([userId, date])
  @@index([deepPlanId, date])
}

model PlanTask2 {
  id              String           @id @default(cuid())
  dailyPlanId     String
  title           String
  description     String?          @db.Text
  knowledgeArea   String
  estimatedMinutes Int             @default(30)
  actualMinutes   Int?
  status          PlanTaskStatus2  @default(TODO)
  priority        PlanTaskPriority @default(MEDIUM)
  order           Int              @default(0)
  aiGenerated     Boolean          @default(true)
  resources       Json?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  dailyPlan       DailyPlan        @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@index([dailyPlanId, status])
  @@index([dailyPlanId, order])
}

model PlanEditRequest {
  id            String     @id @default(cuid())
  deepPlanId    String
  userMessage   String     @db.Text
  aiResponse    String?    @db.Text
  appliedAt     DateTime?
  createdAt     DateTime   @default(now())

  deepPlan      DeepPlan   @relation(fields: [deepPlanId], references: [id], onDelete: Cascade)

  @@index([deepPlanId, createdAt])
}

model Note {
  id            String       @id @default(cuid())
  userId        String
  dailyPlanId   String?
  title         String
  content       Json
  plainText     String?      @db.Text
  tags          String[]     @default([])
  isPinned      Boolean      @default(false)
  date          DateTime     @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan     DailyPlan?   @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  embeddings    NoteEmbedding[]
  spacedReviews SpacedReview[]

  @@index([userId, date])
  @@index([userId, dailyPlanId])
  @@index([userId, isPinned])
}

model NoteEmbedding {
  id            String                 @id @default(cuid())
  noteId        String
  chunkIndex    Int                    @default(0)
  chunkText     String                 @db.Text
  embedding     Unsupported("vector(1024)")?
  createdAt     DateTime               @default(now())

  note          Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, chunkIndex])
  @@index([noteId])
}

model SpacedReview {
  id             String    @id @default(cuid())
  userId         String
  noteId         String?
  title          String
  box            Int       @default(1) // Leitner Box (1-5)
  intervalDays   Int       @default(1) // Khoảng cách ôn tập tiếp theo (ngày)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@index([userId, noteId])
}
